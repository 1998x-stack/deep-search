{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1998x-stack/deep-search/schemas/research-plan.schema.json",
  "title": "Deep Search research plan",
  "type": "object",
  "required": ["schema_version", "question", "created_at", "scope", "subquestions", "budget"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "question": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "properties": {
        "geography": {"type": ["string", "null"]},
        "date_start": {"type": ["string", "null"]},
        "date_end": {"type": ["string", "null"]}
      }
    },
    "subquestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "queries"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q[0-9]{2,}$"},
          "type": {"type": "string"},
          "question": {"type": "string", "minLength": 1},
          "queries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 400}}
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_queries", "max_results_per_query", "max_fetch"],
      "properties": {
        "max_queries": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_results_per_query": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_fetch": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}

