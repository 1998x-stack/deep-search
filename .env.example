DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
GOOGLE_API_KEY=
GOOGLE_CSE_ID=


# Optional OpenAI Responses API provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6
OPENAI_BASE_URL=https://api.openai.com/v1
# Playwright uses no API key; install the optional browser extra.


# Pi-agent-configured provider (recommended default in this workspace)
# Values normally come from ~/.pi/agent/models.json (provider "iagent"), so the
# variables below are overrides only. The key may also be declared there as a
# `!cat /path/to/keyfile` command; it is never printed, logged or persisted.
IAGENT_API_KEY=
IAGENT_BASE_URL=
IAGENT_MODEL=
# Point the resolver at an alternative models.json (tests/CI use this)
PI_MODELS_JSON=


# Logging: run-scoped loguru sinks are written to <out>/logs/ automatically
DEEP_SEARCH_LOG_LEVEL=INFO
